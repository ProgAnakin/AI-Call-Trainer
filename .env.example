# Copy to .env and fill in the values from your Supabase project.
# Both are public by design: the anon key is meant to ship in the browser and is
# constrained by row-level security.
#
# The ANTHROPIC_API_KEY NEVER goes here. It lives only as an Edge Function
# secret, so it is never served to a browser:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#
# Leave this file alone to run in demo mode (scripted prospect, no API calls).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
